# ===============================
# 1. 构建输出目录 (CMake, QMake, VS)
# ===============================
# out/ 目录通常是 QtCreator 的默认构建目录
out/
# CMake 的构建目录
build/
# 其他常见的构建目录
bin/
lib/
bld/
x64/
x86/
Debug/
Release/
cmake-build-*/

# ===============================
# 2. CMake 中间产物
# ===============================
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake
CMakeScripts/
*.cmake
# 注意：不要忽略 CMakeLists.txt 和 CMakePresets.json 本身！

# ===============================
# 3. Protobuf / gRPC 自动生成的代码
# ===============================
# 如果你使用 CMake 自动生成 proto 代码，它们通常在 build/generated 目录下，已被上面的 build/ 忽略。
# 为了防止不小心把生成的源码放到源码目录，加上以下保险：
*.pb.cc
*.pb.h
*.grpc.pb.cc
*.grpc.pb.h

# ===============================
# 4. vcpkg 相关 (如果作为子模块在项目里)
# ===============================
# 如果你把 vcpkg 下载的库直接放在了项目里(虽然你不推荐这么做)
vcpkg_installed/

# ===============================
# 5. Visual Studio 2022 相关
# ===============================
.vs/
*.ipch
*.aps
*.suo
*.user
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.ncb
*.cachefile
*.tlog
*.lastbuildstate
*.unsuccessfulbuild

# ===============================
# 6. Qt / QMake 相关
# ===============================
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
/.qmake.cache
/.qmake.stash
Makefile*
*.pro.user*
*.qbs.user*
CMakeLists.txt.user*
*build-*
_object_script.*
*_plugin_import.cpp
*.autosave

# ===============================
# 7. 编译与链接产物 (通用)
# ===============================
*.exe
*.dll
*.lib
*.obj
*.o
*.out
*.app
*.pdb
*.idb
*.ilk
*.manifest
*.res

# ===============================
# 8. 日志与数据库文件
# ===============================
*.log
*.db
*.sqlite

# ===============================
# 9. 操作系统相关
# ===============================
.DS_Store
Thumbs.db
Desktop.ini

# Node.js 相关
node_modules/
npm-debug.log
