{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-vcpkg",
            "displayName": "Windows x64 (vcpkg)",
            "generator": "Visual Studio 17 2022",
            "architecture": {
                "value": "x64",
                "strategy": "set"
            },
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "linux-vcpkg",
            "displayName": "Ubuntu 26.04 x64 Release (vcpkg)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/linux-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "/opt/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "VCPKG_HOST_TRIPLET": "x64-linux-release",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "VCPKG_TARGET_TRIPLET": "x64-linux-release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "displayName": "Windows Debug",
            "configurePreset": "windows-vcpkg",
            "configuration": "Debug"
        },
        {
            "name": "windows-release",
            "displayName": "Windows Release",
            "configurePreset": "windows-vcpkg",
            "configuration": "Release"
        },
        {
            "name": "linux-release",
            "displayName": "Ubuntu 26.04 Release",
            "configurePreset": "linux-vcpkg"
        }
    ]
}
